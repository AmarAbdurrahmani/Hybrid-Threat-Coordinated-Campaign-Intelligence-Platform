# Copy to .env and fill in. Never commit .env.

# Security
API_KEY=change-me                       # analyst key for all monitoring and operations endpoints
INGEST_API_KEY=                          # optional separate key, limited to ingestion endpoints
ALLOW_UNAUTHENTICATED=false              # enable only for isolated local demos
PSEUDONYM_SECRET=long-random-string     # HMAC key for pseudonymising platform user IDs
KEEP_DISPLAY_NAMES=false
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# YouTube Data API v3 (console.cloud.google.com → enable "YouTube Data API v3" → API key)
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_IDS=                      # comma-separated IDs to watch from startup
YOUTUBE_SEARCH_QUERY=                   # e.g. Kosovo Serbia KFOR  (search costs 100 quota units; runs every 30 min)
YOUTUBE_SEARCH_LANG=sq
YOUTUBE_POLL_S=90

# Telegram public channels (my.telegram.org → API development tools). Run `python ingest.py telegram-login` once.
TG_API_ID=
TG_API_HASH=
TG_CHANNELS=                            # comma-separated @usernames of PUBLIC channels
TG_POLL_S=120

# Telegram bot alerting (@BotFather → token; add bot to the command chat; get chat id via getUpdates)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
ALERT_EXERCISE_CHAT_ID=                  # optional separate destination for exercises
ALERT_DRY_RUN=true                      # set to false to actually send
ALERT_COOLDOWN_S=900
ALERT_ON_SIMULATED=true                 # simulated swarms still alert, always tagged EXERCISE

# Engine
EMBED_BACKEND=auto                      # auto | tfidf
COACTIVITY_WINDOW_S=300
COACTIVITY_MIN_THREADS=2
GRAPH_LOOKBACK_H=48

# Optional: LLM-assisted calque review
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Optional: GeoLite2 databases for your own portal's server-side IPs
GEOIP_ASN_DB=
GEOIP_CITY_DB=

DASHBOARD_PATH=../frontend/index.html
DB_PATH=htccip.db
